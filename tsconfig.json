{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "server.ts",
    "vite.config.ts",
    "miniapp/**/*.ts",
    "miniapp/**/*.tsx",
    "src/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "dist-miniapp"]
}
