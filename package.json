{
  "name": "pna-rewards-telegram-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "dev:worker": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "tail": "npx wrangler tail",
    "build": "vite build && npm run build:worker",
    "build:miniapp": "vite build",
    "build:worker": "esbuild src/index.js --bundle --format=esm --target=es2022 --outfile=dist/index.js",
    "lint": "node scripts/check-syntax.js && tsc --noEmit",
    "test:device-verify": "node scripts/verify-device-verification.mjs",
    "webhook:set": "node scripts/set-webhook.js",
    "webhook:info": "node scripts/webhook-info.js",
    "db:migrate:local": "npx wrangler d1 migrations apply pna-rewards-db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply pna-rewards-db --remote",
    "db:list:remote": "npx wrangler d1 migrations list pna-rewards-db --remote",
    "db:integrity:remote": "npx wrangler d1 execute pna-rewards-db --remote --file=scripts/d1-integrity-check.sql",
    "db:apply:0002:remote": "npx wrangler d1 execute pna-rewards-db --remote --file=migrations/0002_device_verification.sql",
    "clean": "rm -rf dist dist-miniapp"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
