PNA_LOG_CHANNEL_ID=
TIMEZONE=Asia/Kolkata
DEVICE_VERIFICATION_ENABLED=true
MINIAPP_URL=https://ais-pre-5anw25hqtptdicmzho3ex7-704214232389.asia-east1.run.app
